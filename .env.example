# Copy to .env and uncomment what you need. .env is gitignored.
#
# Which backend is used, in order of precedence:
#   1. an explicit store path on the command line  -> always that JSON file
#   2. FAIRCHECK_STORE=json|mongo                  -> forces that backend
#   3. MONGODB_URI set                             -> MongoDB
#   4. nothing set                                 -> JSON file (the default)

# --- MongoDB via docker-compose.yml (docker compose up -d) ---
# MONGODB_URI=mongodb://faircheck:faircheck@localhost:27017/?authSource=admin

# --- MongoDB Atlas or any other hosted instance ---
# Never commit a URI with real credentials in it.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database name. Defaults to "faircheck".
# MONGODB_DB=faircheck

# Force a backend regardless of MONGODB_URI — handy to keep the URI on file
# while working against the JSON store.
# FAIRCHECK_STORE=json

# Where the JSON store lives. Defaults to data/receipts.json.
# FAIRCHECK_STORE_PATH=data/receipts.json

# Port for the local web UI. Defaults to 3000.
# PORT=3000

# Only read by the test suite: without it the MongoDB tests skip themselves,
# so `npm test` passes on a fresh clone with no database running.
# MONGODB_TEST_URI=mongodb://faircheck:faircheck@localhost:27017/?authSource=admin
