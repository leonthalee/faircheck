  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "tsx": "^4.23.8",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "csv-parse": "^7.0.2",
    "express": "^5.2.1"
  }
