{
  "name": "faircheck",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "cli": "tsx src/cli.ts",
    "web": "tsx src/cli.ts serve",
    "test": "node --import tsx --test test/parse.test.ts test/split.test.ts test/merge.test.ts"
  },
  "keywords": ["receipts", "csv", "expense-splitting", "cli", "self-hosted"],
